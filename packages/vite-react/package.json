{
  "name": "@inspect-devtools/vite-react",
  "version": "0.6.0",
  "description": "Vite source inspector for React applications.",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/reeswell/inspect-devtools.git" },
  "homepage": "https://github.com/reeswell/inspect-devtools#readme",
  "bugs": { "url": "https://github.com/reeswell/inspect-devtools/issues" },
  "keywords": ["vite", "react", "devtools", "inspector", "source-location"],
  "engines": { "node": ">=18" },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.json --emitDeclarationOnly",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@inspect-devtools/client": "workspace:*",
    "@inspect-devtools/core": "workspace:*",
    "@babel/generator": "^7.29.7",
    "@babel/parser": "^7.29.7",
    "@babel/traverse": "^7.29.7",
    "@babel/types": "^7.29.7"
  },
  "peerDependencies": {
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0"
  },
  "devDependencies": {
    "@types/babel__generator": "^7.27.0",
    "@types/babel__traverse": "^7.28.0",
    "vite": "^7.1.10",
    "vitest": "^3.2.4"
  }
}
