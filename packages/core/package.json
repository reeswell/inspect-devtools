{
  "name": "@inspect-devtools/core",
  "version": "0.7.3",
  "description": "Core runtime for Inspect Devtools Vite plugins.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reeswell/inspect-devtools.git"
  },
  "homepage": "https://github.com/reeswell/inspect-devtools#readme",
  "bugs": {
    "url": "https://github.com/reeswell/inspect-devtools/issues"
  },
  "keywords": [
    "vite",
    "devtools",
    "inspector",
    "source-location"
  ],
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.json --emitDeclarationOnly",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "launch-editor": "^2.13.2"
  },
  "devDependencies": {
    "vite": "^7.1.10",
    "vitest": "^3.2.4"
  }
}
