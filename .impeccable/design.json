{
  "schemaVersion": 2,
  "name": "DevTools AI",
  "register": "product",
  "northStar": "The Nuxt-Like Component Workbench",
  "sourceDocuments": [
    "PRODUCT.md",
    "DESIGN.md"
  ],
  "colorMeta": {
    "strategy": "restrained devtool palette copied from Nuxt DevTools green state language",
    "tokens": {
      "graphiteBg": "#101114",
      "graphitePanel": "#17191f",
      "graphiteSurface": "#20232b",
      "graphiteInput": "#111318",
      "graphiteLine": "#343946",
      "inkPrimary": "#f2f4f8",
      "inkMuted": "#9ba3b4",
      "nuxtBrandGreen": "#00DC82",
      "nuxtPrimaryGreen": "#099e61",
      "greenSoft": "#e6fff6",
      "warningAmber": "#ffb86b",
      "dockBg": "#ffffffeb"
    },
    "rules": [
      "Use #00DC82 and #099e61 as the only green action colors.",
      "Move text, border, focus ring, and soft fill together as one contextual green state.",
      "Keep inner panes dark, bordered, and flat; reserve strong shadow for the floating bottom panel."
    ]
  },
  "typographyMeta": {
    "sans": "DM Sans, ui-sans-serif, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif",
    "mono": "DM Mono, ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace",
    "scale": {
      "title": "700 16px/1.2 sans",
      "section": "700 13px/1.2 sans",
      "body": "400 12px/1.45 sans",
      "label": "800 11px/1.2 sans",
      "mono": "400 12px/1.35 mono"
    },
    "rules": [
      "Do not use display typography inside the DevTools surface.",
      "Use mono for file paths, git rows, selectors, refs, diffs, and stack-like values."
    ]
  },
  "radius": {
    "xs": "5px",
    "sm": "6px",
    "md": "8px",
    "panel": "10px",
    "pill": "999px"
  },
  "shadows": {
    "floatingPanel": "0 -18px 54px rgba(0, 0, 0, 0.42)",
    "bottomDock": "0 18px 42px rgba(0, 0, 0, 0.18)",
    "sourceBadge": "0 10px 26px rgba(4, 120, 87, 0.28)",
    "inspectorHalo": "0 0 0 1px rgba(7, 95, 70, 0.28), 0 0 0 9999px rgba(15, 23, 42, 0.04)"
  },
  "motion": {
    "duration": "160ms to 200ms",
    "easing": "ease-out state transitions",
    "rules": [
      "Animate state feedback only: hover, focus, active, panel reveal, and source badge feedback.",
      "Respect prefers-reduced-motion with instant state changes when motion is reduced."
    ]
  },
  "breakpoints": {
    "mobile": "max-width: 520px",
    "desktopPanel": "65vw centered",
    "mobilePanel": "calc(100vw - 16px)"
  },
  "componentSnippets": [
    {
      "name": "Bottom Dock",
      "html": "<div class=\"ds-bottom-dock\"><button class=\"ds-dock-button is-active\">△</button><span class=\"ds-dock-divider\"></span><button class=\"ds-dock-button ds-dock-panel\">Panel</button></div>",
      "css": ".ds-bottom-dock{display:flex;align-items:center;justify-content:center;gap:4px;height:36px;padding:3px;border:1px solid rgba(52,57,70,.42);border-radius:999px;background:#ffffffeb;box-shadow:0 18px 42px rgba(0,0,0,.18);backdrop-filter:blur(12px)}.ds-dock-button{display:grid;place-items:center;width:30px;height:30px;border:0;border-radius:999px;background:transparent;color:#52606f;font:800 11px/1 'DM Sans',system-ui;cursor:pointer}.ds-dock-panel{width:48px}.ds-dock-button:hover,.ds-dock-button.is-active{background:#e6fff6;color:#099e61}.ds-dock-button.is-active{box-shadow:inset 0 0 0 1px rgba(9,158,97,.36)}.ds-dock-divider{width:1px;height:16px;background:#d6dbe3}"
    },
    {
      "name": "Primary Button",
      "html": "<button class=\"ds-button ds-button-primary\">Inspect</button>",
      "css": ".ds-button{height:34px;border:1px solid #343946;border-radius:6px;padding:0 10px;font:800 12px/1 'DM Sans',system-ui;transition:border-color .16s ease,background-color .16s ease,color .16s ease,box-shadow .16s ease}.ds-button-primary{border-color:#00DC82;background:#00DC82;color:#04100d}.ds-button-primary:hover{border-color:#18e493;background:#18e493}.ds-button-primary:focus-visible{outline:0;box-shadow:0 0 0 2px rgba(0,220,130,.5)}"
    },
    {
      "name": "Secondary Button",
      "html": "<button class=\"ds-button ds-button-secondary\">Open</button>",
      "css": ".ds-button{height:30px;border:1px solid #343946;border-radius:6px;padding:0 10px;font:700 12px/1 'DM Sans',system-ui;transition:border-color .16s ease,background-color .16s ease,color .16s ease,opacity .16s ease}.ds-button-secondary{background:#262a33;color:#f2f4f8}.ds-button-secondary:hover{border-color:rgba(0,220,130,.72);background:rgba(0,220,130,.05);color:#00DC82}.ds-button-secondary:disabled{cursor:not-allowed;opacity:.45}"
    },
    {
      "name": "Segmented Tabs",
      "html": "<div class=\"ds-tabs\"><button class=\"ds-tab is-selected\">Inspect</button><button class=\"ds-tab\">Git</button></div>",
      "css": ".ds-tabs{display:inline-flex;align-items:center;gap:6px;border:1px solid #343946;border-radius:7px;background:#111318;padding:3px}.ds-tab{height:26px;border:1px solid transparent;border-radius:5px;background:transparent;color:#9ba3b4;padding:0 9px;font:750 12px/1 'DM Sans',system-ui}.ds-tab:hover{border-color:rgba(0,220,130,.72);color:#00DC82}.ds-tab.is-selected{border-color:rgba(0,220,130,.16);background:#26302e;color:#00DC82}"
    },
    {
      "name": "Panel Surface",
      "html": "<section class=\"ds-surface\"><div class=\"ds-heading\"><h2>Selection</h2><button class=\"ds-mini-button\">Open</button></div></section>",
      "css": ".ds-surface{border:1px solid rgba(52,57,70,.9);border-radius:8px;background:#20232b;color:#f2f4f8;padding:12px;box-shadow:0 1px 2px rgba(0,0,0,.18)}.ds-heading{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:10px}.ds-heading h2{margin:0;font:700 13px/1.2 'DM Sans',system-ui}.ds-mini-button{height:30px;border:1px solid #343946;border-radius:6px;background:#262a33;color:#f2f4f8;padding:0 10px;font:700 12px/1 'DM Sans',system-ui}"
    },
    {
      "name": "Text Input",
      "html": "<textarea class=\"ds-input\" placeholder=\"Generated commit message will appear here.\"></textarea>",
      "css": ".ds-input{width:100%;min-height:52px;border:1px solid #343946;border-radius:8px;background:#111318;color:#f2f4f8;padding:9px 10px;font:400 12px/1.45 'DM Sans',system-ui;resize:vertical}.ds-input::placeholder{color:#7f8797}.ds-input:focus{border-color:rgba(0,220,130,.72);outline:0;box-shadow:0 0 0 2px rgba(0,220,130,.5)}"
    },
    {
      "name": "Status Pill",
      "html": "<span class=\"ds-status-pill\">vue</span>",
      "css": ".ds-status-pill{display:inline-flex;align-items:center;height:24px;border:1px solid rgba(0,220,130,.16);border-radius:6px;background:rgba(0,220,130,.08);color:#00DC82;padding:0 8px;font:700 12px/1 'DM Sans',system-ui;white-space:nowrap}"
    },
    {
      "name": "Source Badge",
      "html": "<button class=\"ds-source-badge\"><strong>App.vue:16</strong><span>Open in editor</span></button>",
      "css": ".ds-source-badge{display:grid;justify-items:start;gap:2px;max-width:360px;min-height:36px;border:0;border-radius:5px;background:#099e61;color:#fff;padding:6px 9px;text-align:left;box-shadow:0 10px 26px rgba(4,120,87,.28);font-family:'DM Sans',system-ui}.ds-source-badge strong,.ds-source-badge span{max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.ds-source-badge strong{font:800 12px/1.1 'DM Sans',system-ui}.ds-source-badge span{font:400 11px/1.1 'DM Sans',system-ui;opacity:.82}"
    }
  ]
}
