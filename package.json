{
  "name": "inspect-devtools-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "play:react": "pnpm --filter @inspect-devtools/playground-react dev",
    "play:vue": "pnpm --filter @inspect-devtools/playground-vue dev",
    "release:check": "pnpm test && pnpm typecheck && pnpm build"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "jsdom": "^26.1.0",
    "turbo": "^2.9.12",
    "typescript": "^5.9.3",
    "vite": "^7.1.10",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.5"
  }
}
